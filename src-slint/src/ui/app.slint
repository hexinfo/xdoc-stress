// x-doc 核心链路压测 —— Slint UI（浅色三栏：文件 / 结果+日志 / 配置）
// 纯 Rust GUI，无 webkit/gtk，兼容 glibc 2.28

import { CheckBox, ScrollView } from "std-widgets.slint";

// ── 数据结构（Rust 侧填充） ──
export struct FileItem {
    name: string,
    path: string,
    size: string,
    checked: bool,
}

export struct ResultRowUi {
    no: string,
    file-name: string,
    page-count: string,
    upload: string,
    ready: string,
    download: string,
    convert: string,
    first: string,
    full: string,
    e2e: string,
    // 0 运行中(蓝点) / 1 成功(绿勾) / 2 失败(红叉)
    state: int,
    failed: bool,
}

// ── 通用小组件 ──

// 分组标签（蓝色小节标题）
component Section inherits Text {
    font-size: 11px;
    font-weight: 700;
    color: #2563eb;
}

// 字段标签（灰色）
component GLabel inherits Text {
    font-size: 11px;
    color: #5f6672;
}

// 输入框（白底、蓝选区、等宽字体）
component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> value;
    height: 28px;
    border-radius: 6px;
    background: #ffffff;
    border-width: 1px;
    border-color: #d9dce1;
    forward-focus: input;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        VerticalLayout {
            alignment: center;
            input := TextInput {
                text <=> root.value;
                font-size: 12px;
                font-family: "Menlo";
                color: #1a1d24;
                selection-background-color: #2563eb;
                selection-foreground-color: #ffffff;
            }
        }
    }
    if root.value == "": HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.placeholder;
                font-size: 11px;
                font-family: "Menlo";
                color: #9ba1ad;
                overflow: TextOverflow.elide;
            }
        }
    }
}

// 按钮：primary 蓝色实心 / danger 红字白底 / 普通白底灰边
component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> small: false;
    in property <bool> enabled: true;
    callback clicked;
    height: root.small ? 22px : 32px;
    border-radius: root.small ? 5px : 7px;
    border-width: 1px;
    border-color: !root.enabled ? #e3e6ea
        : root.primary ? #2563eb
        : root.danger ? #fca5a5
        : #d9dce1;
    background: !root.enabled ? #f5f6f8
        : root.primary ? (ta.has-hover ? #1d4ed8 : #2563eb)
        : root.danger ? (ta.has-hover ? #fef2f2 : #ffffff)
        : (ta.has-hover ? #f0f4ff : #ffffff);
    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    HorizontalLayout {
        alignment: center;
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            font-size: root.small ? 11px : 13px;
            font-weight: root.small ? 500 : 600;
            color: !root.enabled ? #c3c8d0
                : root.primary ? #ffffff
                : root.danger ? #dc2626
                : #33383f;
            vertical-alignment: center;
            overflow: TextOverflow.elide;
        }
    }
}

// 面板卡片
component Panel inherits Rectangle {
    background: #ffffff;
    border-radius: 10px;
    border-width: 1px;
    border-color: #e3e6ea;
}

// 面板标题行文字
component PanelTitle inherits Text {
    font-size: 13px;
    font-weight: 700;
    color: #1a1d24;
    vertical-alignment: center;
}

// 表格单元格
component Cell inherits Text {
    font-size: 11px;
    font-family: "Menlo";
    color: #33383f;
    vertical-alignment: center;
    overflow: TextOverflow.elide;
    height: 24px;
}

// 表头单元格
component HCell inherits Text {
    font-size: 10px;
    font-weight: 600;
    color: #5f6672;
    vertical-alignment: center;
    overflow: TextOverflow.elide;
}

export component App inherits Window {
    title: "x-doc 核心链路压测";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1060px;
    min-height: 600px;
    background: #f0f2f5;

    // ── 数据模型 ──
    in-out property <[FileItem]> files;
    in-out property <[ResultRowUi]> results;

    // ── 配置 ──
    in-out property <string> base-url: "http://127.0.0.1:8080/dvs";
    in-out property <string> auth-token: "";
    in-out property <string> auth-headers: "";
    in-out property <string> concurrency: "1";
    in-out property <string> repeats: "2";
    in-out property <string> range-chunk: "1048576";
    in-out property <string> tile-batch: "10";
    in-out property <string> poll-interval: "1000";
    in-out property <string> poll-max: "600";

    // ── 状态 ──
    in-out property <bool> running: false;
    in-out property <string> status-text: "就绪";
    in-out property <string> log-text: "";
    in-out property <bool> all-checked: false;

    // ── 回调（Rust 侧连接） ──
    callback start-test();
    callback stop-test();
    callback pick-folder();
    callback pick-files();
    callback clear-files();
    callback toggle-all(bool);
    callback files-changed();
    callback copy-results();
    callback export-csv();

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        // ════ 左栏：文件 ════
        Panel {
            width: 300px;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;
                    PanelTitle { text: "文件"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    CheckBox {
                        text: "全选";
                        checked: root.all-checked;
                        toggled => { root.toggle-all(self.checked); }
                    }
                    Btn {
                        label: "清空";
                        small: true;
                        clicked => { root.clear-files(); }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Btn {
                        label: "文件夹";
                        horizontal-stretch: 1;
                        clicked => { root.pick-folder(); }
                    }
                    Btn {
                        label: "文件";
                        horizontal-stretch: 1;
                        clicked => { root.pick-files(); }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    if root.files.length == 0: Text {
                        text: "点上方按钮选择文件夹或文件";
                        font-size: 12px;
                        color: #9ba1ad;
                        horizontal-alignment: center;
                    }
                    ScrollView {
                        VerticalLayout {
                            padding: 2px;
                            spacing: 0px;
                            for f in root.files: Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: list-ta.has-hover ? #f0f4ff : transparent;
                                list-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                }
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    spacing: 5px;
                                    VerticalLayout { alignment: center; CheckBox {
                                        checked: f.checked;
                                        toggled => {
                                            f.checked = self.checked;
                                            root.files-changed();
                                        }
                                    } }
                                    Text {
                                        text: f.name;
                                        font-size: 12px;
                                        color: #33383f;
                                        vertical-alignment: center;
                                        overflow: TextOverflow.elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }

                Text {
                    height: 18px;
                    text: root.files.length + " 个文件";
                    font-size: 11px;
                    color: #9ba1ad;
                    vertical-alignment: center;
                }
            }
        }

        // ════ 中栏：结果 + 日志 ════
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;

            // 结果面板
            Panel {
                vertical-stretch: 3;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 6px;
                        PanelTitle { text: "结果"; }
                        Text {
                            text: root.status-text;
                            font-size: 11px;
                            color: #5f6672;
                            vertical-alignment: center;
                            overflow: TextOverflow.elide;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Btn { label: "复制"; small: true; clicked => { root.copy-results(); } }
                        Btn { label: "CSV"; small: true; clicked => { root.export-csv(); } }
                    }

                    // 表格（表头 + 行，整体滚动）
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #eef0f3;
                        clip: true;
                        if root.results.length == 0: Text {
                            text: root.running ? "运行中…" : "配置参数后点「开始测试」";
                            color: #9ba1ad;
                            font-size: 13px;
                        }
                        if root.results.length > 0: ScrollView {
                            VerticalLayout {
                                // 表头
                                Rectangle {
                                    height: 26px;
                                    background: #f8f9fb;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        HCell { text: "#"; width: 22px; }
                                        HCell { text: "文件"; horizontal-stretch: 1; }
                                        HCell { text: "页数"; width: 30px; horizontal-alignment: right; }
                                        HCell { text: "上传"; width: 44px; horizontal-alignment: right; }
                                        HCell { text: "就绪"; width: 44px; horizontal-alignment: right; }
                                        HCell { text: "下载"; width: 44px; horizontal-alignment: right; }
                                        HCell { text: "转换"; width: 44px; horizontal-alignment: right; }
                                        HCell { text: "首页"; width: 44px; horizontal-alignment: right; }
                                        HCell { text: "全页"; width: 44px; horizontal-alignment: right; }
                                        HCell { text: "端到端"; width: 48px; horizontal-alignment: right; }
                                        HCell { text: "状态"; width: 26px; horizontal-alignment: center; }
                                    }
                                }
                                // 数据行
                                for r in root.results: Rectangle {
                                    height: 24px;
                                    background: r.failed ? #fef2f2 : (row-ta.has-hover ? #f8faff : transparent);
                                    row-ta := TouchArea { }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Cell { text: r.no; width: 22px; color: #9ba1ad; }
                                        Cell { text: r.file-name; horizontal-stretch: 1; }
                                        Cell { text: r.page-count; width: 30px; horizontal-alignment: right; }
                                        Cell { text: r.upload; width: 44px; horizontal-alignment: right; }
                                        Cell { text: r.ready; width: 44px; horizontal-alignment: right; }
                                        Cell { text: r.download; width: 44px; horizontal-alignment: right; }
                                        Cell { text: r.convert; width: 44px; horizontal-alignment: right; }
                                        Cell { text: r.first; width: 44px; horizontal-alignment: right; }
                                        Cell { text: r.full; width: 44px; horizontal-alignment: right; }
                                        Cell { text: r.e2e; width: 48px; horizontal-alignment: right; color: #b45309; font-weight: 600; }
                                        Rectangle {
                                            width: 26px;
                                            height: 24px;
                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                background: r.state == 0 ? #2563eb : r.state == 1 ? #16a34a : #dc2626;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 日志面板
            Panel {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    PanelTitle { text: "运行日志"; }

                    Rectangle {
                        vertical-stretch: 1;
                        background: #f8f9fb;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #eef0f3;
                        ScrollView {
                            VerticalLayout {
                                padding: 6px;
                                Text {
                                    text: root.log-text == "" ? "等待运行…" : root.log-text;
                                    font-size: 11px;
                                    font-family: "Menlo";
                                    color: #424a53;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ════ 右栏：配置 ════
        Panel {
            width: 300px;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                PanelTitle { text: "配置"; }

                ScrollView {
                    VerticalLayout {
                        spacing: 5px;

                        Section { text: "目标"; }
                        GLabel { text: "BASE_URL"; }
                        Field {
                            placeholder: "http://host:8080/dvs";
                            value <=> root.base-url;
                        }
                        GLabel { text: "AUTH_TOKEN（Bearer）"; }
                        Field {
                            placeholder: "eyJhbGciOi…（留空则不带）";
                            value <=> root.auth-token;
                        }
                        GLabel { text: "AUTH_HEADERS（JSON，Cookie 等）"; }
                        Field {
                            placeholder: "{\"Cookie\":\"JSESSIONID=abc123\"}";
                            value <=> root.auth-headers;
                        }

                        Section { text: "并发"; }
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                GLabel { text: "线程"; }
                                Field { value <=> root.concurrency; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                GLabel { text: "轮次"; }
                                Field { value <=> root.repeats; }
                            }
                        }

                        Section { text: "拉取"; }
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                GLabel { text: "分段 B"; }
                                Field { value <=> root.range-chunk; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                GLabel { text: "瓦片批"; }
                                Field { value <=> root.tile-batch; }
                            }
                        }

                        Section { text: "轮询"; }
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                GLabel { text: "间隔 ms"; }
                                Field { value <=> root.poll-interval; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                GLabel { text: "上限"; }
                                Field { value <=> root.poll-max; }
                            }
                        }

                        Rectangle { height: 4px; }

                        HorizontalLayout {
                            spacing: 6px;
                            Btn {
                                label: "▶ 开始测试";
                                primary: true;
                                enabled: !root.running;
                                horizontal-stretch: 1;
                                clicked => { root.start-test(); }
                            }
                            Btn {
                                label: "■ 停止";
                                danger: true;
                                enabled: root.running;
                                horizontal-stretch: 1;
                                clicked => { root.stop-test(); }
                            }
                        }

                        // 吸收面板多余高度，避免上方各项被撑开
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }
    }
}
